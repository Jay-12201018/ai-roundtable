{
  "name": "ai-roundtable",
  "version": "0.1.0",
  "description": "AI Roundtable desktop application",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "predev": "pnpm native:electron",
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "typecheck": "tsc --noEmit --pretty false",
    "pretest": "pnpm native:node",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "prepreview": "pnpm native:electron",
    "preview": "electron-vite preview",
    "pack": "pnpm build && electron-builder",
    "dist": "pnpm build && electron-builder",
    "native:node": "pnpm rebuild better-sqlite3",
    "native:electron": "electron-rebuild --force --which-module better-sqlite3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.62.0",
    "@google/genai": "^1.20.0",
    "@radix-ui/react-slot": "^1.2.3",
    "better-sqlite3": "12.11.1",
    "lucide-react": "^0.544.0",
    "openai": "^5.20.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "38.8.6",
    "electron-builder": "26.15.3",
    "electron-vite": "^4.0.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
